// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
        "name": "Production City Holding Page",
        // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
        "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
        "features": {
                "ghcr.io/devcontainers/features/common-utils:2": {
                        "installZsh": true,
                        "configureZshAsDefaultShell": true,
                        "installOhMyZsh": true,
                        "installOhMyZshConfig": true,
                        "upgradePackages": true,
                        "nonFreePackages": true,
                        "installSsl": true,
                        "username": "vscode",
                        "userUid": "automatic",
                        "userGid": "automatic"
                },
                "ghcr.io/devcontainers/features/git:1": {},
                "ghcr.io/devcontainers/features/node:1": {
                        "version": "25"
                },
                "ghcr.io/devcontainers/features/github-cli:1": {
                        "installDirectlyFromGitHubRelease": true,
                        "version": "latest"
                },
                "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
                "ghcr.io/flexwie/devcontainer-features/op:1": {},
                "ghcr.io/devcontainers-extra/features/cloudflare-wrangler:1": {
                        "version": "latest"
                },
                "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
                        "moby": false
                },
                "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
                        "plugins": "ssh-agent npm",
                        "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions",
                        "username": "vscode"
                },
                "ghcr.io/devcontainers-extra/features/apt-packages:1": {
                        "packages": "ripgrep"
                }
        },
        "containerEnv": {
                "PLAYWRIGHT_CHROMIUM_PATH": "/usr/bin/chromium"
        },
        "runArgs": [
                "--env-file",
                ".env"
        ],
        "forwardPorts": [4321, 6006, 8787],
        "portsAttributes": {
                "4321": { "label": "Web (vinext)", "onAutoForward": "notify" },
                "6006": { "label": "Storybook", "onAutoForward": "notify" },
                "8787": { "label": "Backend Worker", "onAutoForward": "silent" }
        },
        "postCreateCommand": "bash .devcontainer/post-create.sh",
        "postStartCommand": "bash .devcontainer/post-start.sh"
}
