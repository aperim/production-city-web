// prisma/schema.prisma
//
// Production City — shared Prisma schema
//
// Current database: Cloudflare D1 (SQLite)
// Planned migration: self-hosted PostgreSQL (TimescaleDB/PostGIS/PGVector)
//
// IMPORTANT: D1 does not support Row Level Security (SQLite limitation).
// When migrating to PostgreSQL, review all models for RLS requirements.
//
// IMPORTANT: D1/SQLite uses TEXT for datetimes. PostgreSQL uses TIMESTAMPTZ.
// Design schemas to be portable — prefer Prisma model-level constraints
// over raw SQL constraints where possible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// User accounts. Soft-deleted via status="deactivated", never hard-deleted.
/// State machine: pending_approval → active ↔ deactivated
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// pending_approval | active | deactivated
  status        String    @default("pending_approval")
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  deactivatedAt DateTime?

  // Relations
  userRoles       UserRole[]    @relation("UserRoles")
  rolesGranted    UserRole[]    @relation("RoleGranter")
  sessions        Session[]
  magicLinks      MagicLink[]
  invitation      Invitation?   @relation("InvitedUser")
  invitationsSent Invitation[]  @relation("InvitedBy")
  auditLogs              AuditLog[]          @relation("AuditSubject")
  auditLogsActed         AuditLog[]          @relation("AuditActor")
  suppressionsRemoved    EmailSuppression[]
  notificationPreferences NotificationPreference[]

  // @@index([email]) — omitted: @unique already creates an index
  @@index([status])
}

/// Named roles (super_admin, admin, member, viewer). System roles cannot be deleted.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  invitationRoles InvitationRole[]
}

/// Fine-grained permissions as resource:action pairs (e.g. user:read, facility:manage).
model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

/// Maps roles to permissions (many-to-many).
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

/// Assigns roles to users. grantedBy tracks which admin granted the role.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  grantedAt DateTime @default(now())
  grantedBy String?

  user          User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("RoleGranter", fields: [grantedBy], references: [id])

  @@unique([userId, roleId])
}

/// Session tokens. Token field stores SHA-256 hash, never plaintext.
model Session {
  id           String    @id @default(cuid())
  userId       String
  token        String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // @@index([token]) — omitted: @unique already creates an index
  @@index([userId])
  @@index([expiresAt])
}

/// Magic links for passwordless auth. tokenHash and codeHash store hashes, never plaintext.
/// codeHash stores HMAC(server_secret, email + purpose + id + code) — no codeSalt needed.
model MagicLink {
  id                String    @id @default(cuid())
  userId            String?
  email             String
  tokenHash         String    @unique
  /// HMAC(server_secret, email + purpose + id + code)
  codeHash          String
  /// login | invitation_accept
  purpose           String
  postmarkMessageId String?
  /// pending | sending | sent | delivered | bounced | failed
  deliveryStatus    String    @default("pending")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  createdAt         DateTime  @default(now())
  /// Must be set explicitly (15 min for login, 7 days for invitations)
  expiresAt         DateTime
  usedAt            DateTime?
  /// One-time token for WebSocket delivery tracking (unauthenticated)
  deliveryToken     String?   @unique
  /// Marks delivery token as consumed after first WebSocket connection
  deliveryTokenUsed Boolean   @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([postmarkMessageId])
}

/// Invitations to join the platform. activeEmail provides DB-level uniqueness for pending invitations.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  invitedById String
  userId      String?   @unique
  /// pending | accepted | expired | revoked
  status      String    @default("pending")
  /// Set to email when status=pending, NULL when accepted/expired/revoked
  activeEmail String?   @unique
  message     String?
  createdAt   DateTime  @default(now())
  /// Must be set explicitly (default 7 days)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  invitedBy       User             @relation("InvitedBy", fields: [invitedById], references: [id])
  user            User?            @relation("InvitedUser", fields: [userId], references: [id])
  invitationRoles InvitationRole[]

  @@index([email])
  @@index([status])
}

/// Maps roles to invitations (pre-assigned roles for when invitation is accepted).
model InvitationRole {
  id           String @id @default(cuid())
  invitationId String
  roleId       String

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([invitationId, roleId])
}

/// Immutable audit log for all auth and admin events.
/// details is JSON-as-string (D1 has no JSON column type).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  subjectId String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor   User? @relation("AuditActor", fields: [actorId], references: [id])
  subject User? @relation("AuditSubject", fields: [subjectId], references: [id])

  @@index([actorId])
  @@index([subjectId])
  @@index([action])
  @@index([createdAt])
}

/// Email suppression list for bounce and spam complaint tracking.
/// Prevents sending to addresses that have bounced or filed complaints.
model EmailSuppression {
  id        String    @id @default(cuid())
  email     String    @unique
  /// hard_bounce | spam_complaint
  reason    String
  /// JSON: Postmark bounce/complaint details
  details   String?
  createdAt DateTime  @default(now())
  /// Set when admin removes suppression
  removedAt DateTime?
  /// userId of admin who removed
  removedBy     String?
  removedByUser User?   @relation(fields: [removedBy], references: [id])
}

/// Media asset with full provenance tracking for attribution and compliance
model MediaAsset {
  id                    String    @id @default(cuid())

  /// Source platform: "pexels" | "unsplash" | "custom" | etc.
  source                String
  /// For external sources, this is the source platform ID (e.g., Pexels photo ID).
  /// For custom assets, use "custom-{cuid}". Must always be populated.
  externalId            String
  /// URL on source platform (provenance only — never used as src)
  externalUrl           String?

  /// Creator name (required for attribution display)
  photographer          String
  /// Creator profile URL
  photographerUrl       String?
  /// Creator ID on source platform
  photographerId        String?

  /// Original width in pixels
  originalWidth         Int
  /// Original height in pixels
  originalHeight        Int
  /// Hex color for skeleton placeholder (e.g., "#2A3B4C")
  averageColor          String?
  /// Alt text — required for accessibility. Must be descriptive and meaningful.
  alt                   String
  /// Original alt text from source (for provenance)
  originalAlt           String?
  /// Restricted to: "image/jpeg", "image/png", "image/webp" (no SVG — script injection risk)
  mimeType              String
  /// File size in bytes
  fileSize              Int?
  /// SHA-256 checksum for integrity verification
  checksum              String?

  /// Relative path from project root (e.g., "public/media/hero-home/hero-home-dark.jpg").
  /// Server-internal — the API must return publicPath instead.
  localPath             String
  /// Public URL path served to clients (e.g., "/media/hero-home/hero-home-dark.jpg").
  /// This is the ONLY path that may appear in API responses and component src attributes.
  publicPath            String
  /// Original download URL (provenance only — NEVER used as src)
  downloadUrl           String?

  /// License identifier: "pexels" | "unsplash" | "cc-by-4.0" | "custom" | etc.
  license               String
  /// Whether attribution is required for display
  attributionRequired   Boolean   @default(true)
  /// Plain text attribution string, e.g., "Photo by Jane Doe on Pexels"
  attributionText       String?

  /// Whether the media was created with AI assistance
  aiAssisted            Boolean   @default(false)
  /// Whether the media was fully AI-generated
  aiGenerated           Boolean   @default(false)
  /// True when media is used with explicit permission of First Nations Peoples
  hasFirstNationsPermission Boolean @default(false)
  /// Free-text field for cultural context, permissions details, community attribution
  culturalNotes         String?

  /// Theme variant: "light" | "dark" | "universal"
  themeVariant          String    @default("universal")
  /// Semantic context: "hero-home", "gallery-facilities", etc.
  contentContext        String?

  /// Sourcing agent: "claude-code", "human", etc.
  sourcingAgent         String?
  /// Search query used for sourcing
  sourcingPrompt        String?
  /// Review status: "accepted" | "rejected" | "pending"
  reviewStatus          String    @default("pending")
  /// Agent review reasoning
  reviewNotes           String?
  /// When review was completed
  reviewedAt            DateTime?

  /// NULL = active; set = archived (soft delete)
  archivedAt            DateTime?
  /// User ID who archived the asset
  archivedBy            String?

  /// When originally downloaded from source
  downloadedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  lightPairs            MediaPair[] @relation("LightAsset")
  darkPairs             MediaPair[] @relation("DarkAsset")

  @@unique([source, externalId])
  @@index([contentContext])
  @@index([themeVariant])
  @@index([reviewStatus])
  @@index([archivedAt])
}

/// Expression of Interest submissions from public landing pages.
/// Categorised by audience type with structured metadata per category.
/// Will be JSONB in PostgreSQL; TEXT for D1 compatibility.
model ExpressionOfInterest {
  id              String    @id @default(cuid())
  /// general | producer | creative | partner | investor | education | employment
  category        String
  /// new | contacted | converted | archived
  status          String    @default("new")
  /// Submission language (validated against supported locales)
  locale          String    @default("en")

  // Common fields
  name            String
  email           String
  message         String?

  // Category-specific structured data (JSON-as-string for D1 compatibility)
  metadata        String?

  // Source tracking
  sourcePage      String
  sourceCategory  String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  // Consent tracking (GDPR / Australian Privacy Act)
  consentVersion     String
  privacyAcceptedAt  DateTime
  marketingOptIn     Boolean   @default(false)

  // Confirmation email
  confirmationSentAt DateTime?
  postmarkMessageId  String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  archivedBy      String?

  // Indexes
  @@index([email])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([sourcePage])
  @@index([locale])
  @@index([confirmationSentAt])
  @@index([category, status, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

/// Pairs a light-mode and dark-mode media asset for a content context
model MediaPair {
  id              String     @id @default(cuid())
  /// Semantic key: "hero-home", "gallery-facilities"
  contentContext  String

  lightAssetId    String
  /// onDelete: Restrict — cannot delete an asset that is part of a pair.
  /// Admin must remove the pair first, then archive the asset.
  lightAsset      MediaAsset @relation("LightAsset", fields: [lightAssetId], references: [id], onDelete: Restrict)

  darkAssetId     String
  /// onDelete: Restrict — see lightAsset comment above.
  darkAsset       MediaAsset @relation("DarkAsset", fields: [darkAssetId], references: [id], onDelete: Restrict)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([contentContext])
  @@index([lightAssetId])
  @@index([darkAssetId])
}

/// Per-user notification preference for real-time WebSocket channels.
/// Controls which notification channels a user receives updates for.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Channel name, e.g. "admin:eoi", "admin:approvals"
  channel   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channel])
  @@index([userId])
  @@index([channel])
}
