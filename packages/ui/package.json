{
  "name": "@productioncity/holding-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Production City design system — React components, atoms, molecules, and organisms built on Tailwind v4 and shadcn/ui conventions.",
  "keywords": ["design-system", "react", "tailwind", "components", "production-city"],
  "repository": {
    "type": "git",
    "url": "https://github.com/productioncity/holding.git",
    "directory": "packages/ui"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./globals.css": "./dist/globals.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "sideEffects": ["./src/globals.css", "./dist/globals.css"],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./i18n-constants": {
      "import": "./src/lib/i18n-constants.ts",
      "types": "./src/lib/i18n-constants.ts"
    },
    "./i18n-format": {
      "import": "./src/lib/i18n-format.ts",
      "types": "./src/lib/i18n-format.ts"
    },
    "./globals.css": "./src/globals.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -p tsconfig.build.json && cp src/globals.css dist/globals.css",
    "test": "vitest run",
    "test:a11y": "vitest run src/__tests__/storybook-a11y.test.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src stories .storybook eslint.config.js vitest.config.ts"
  },
  "dependencies": {
    "@productioncity/holding-design-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.2.17",
    "@storybook/addon-designs": "11.1.2",
    "@storybook/addon-docs": "10.2.17",
    "@storybook/addon-themes": "10.2.17",
    "@storybook/addon-vitest": "10.2.17",
    "@storybook/react-vite": "^10.2.17",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "4.0.18",
    "axe-core": "4.11.1",
    "jsdom": "^28.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.2.17",
    "storybook-design-token": "5.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
