{
  "name": "@productioncity/holding-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/productioncity/holding.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vinext dev --port 4321 --host",
    "generate:dashboard": "node --experimental-transform-types --experimental-detect-module scripts/generate-dashboard-routes.ts",
    "build": "pnpm run generate:dashboard && vinext build && node --experimental-transform-types --experimental-detect-module scripts/generate-sitemap.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:e2e:staging:smoke": "playwright test --config playwright.staging.config.ts --project staging-smoke",
    "lint": "eslint app worker eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts playwright.staging.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "vinext deploy",
    "deploy:staging": "node scripts/cf-deploy.mjs staging",
    "deploy:production": "node scripts/cf-deploy.mjs production"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@productioncity/holding-ui": "workspace:*",
    "@productioncity/masterplan-viewer": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-server-dom-webpack": "^19.2.4",
    "vinext": "^0.0.28"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.2",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "^0.5.21",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.85.0"
  }
}
