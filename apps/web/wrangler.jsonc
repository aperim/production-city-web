// apps/web/wrangler.jsonc — vinext Cloudflare Workers configuration
{
  "name": "holding-web",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holding-dev",
      "database_id": "local-dev",
      "migrations_dir": "../../prisma/migrations"
    }
  ],

  // Multi-environment configuration
  "env": {
    "preview": {
      "name": "holding-web-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "holding-preview",
          "database_id": "$CF_D1_DATABASE_ID_PREVIEW",
          "migrations_dir": "../../prisma/migrations"
        }
      ]
    },
    "staging": {
      "name": "holding-web-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "holding-staging",
          "database_id": "$CF_D1_DATABASE_ID_STAGING",
          "migrations_dir": "../../prisma/migrations"
        }
      ]
    },
    "production": {
      "name": "holding-web-production",
      // Issue #97: Route canonical domain and www (www redirects to canonical in the Worker)
      "routes": [
        { "pattern": "production.city/*", "zone_name": "production.city" },
        { "pattern": "www.production.city/*", "zone_name": "production.city" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "holding-production",
          "database_id": "$CF_D1_DATABASE_ID_PRODUCTION",
          "migrations_dir": "../../prisma/migrations"
        }
      ]
    }
  }
}
