{
  "name": "@productioncity/holding-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/productioncity/holding.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "wrangler dev",
    "generate:dashboard": "node --experimental-transform-types --experimental-detect-module ../web/scripts/generate-dashboard-routes.ts",
    "build": "pnpm run generate:dashboard && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "test": "vitest run",
    "lint": "eslint src test eslint.config.js vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "^1.2.2",
    "@prisma/adapter-d1": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@productioncity/holding-logging": "workspace:*",
    "hono": "^4.12.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@cloudflare/workers-types": "^4.20260426.1",
    "typescript": "^5.9.3",
    "vite": "7.3.5",
    "vitest": "~4.1.5",
    "wrangler": "^4.85.0"
  }
}
