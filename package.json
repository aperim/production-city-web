{
  "name": "production-city",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter './packages/design-tokens' build && pnpm -r run dev",
    "build": "pnpm --filter './packages/design-tokens' build && pnpm --filter './packages/ui' build && pnpm --filter '!./packages/ui' --filter '!./packages/design-tokens' -r run build",
    "test": "vitest run && pnpm -r run test",
    "test:e2e": "pnpm --filter ./apps/web run test:e2e",
    "test:e2e:smoke": "pnpm --filter ./apps/web run test:e2e:smoke",
    "lint": "pnpm -r run lint",
    "lint:media-src": "bash scripts/ci/check-no-external-media-src.sh",
    "typecheck": "pnpm -r run typecheck",
    "build-storybook": "pnpm --filter ./packages/design-tokens run build && pnpm --filter ./packages/ui run build-storybook",
    "generate:dashboard": "pnpm --filter ./apps/web run generate:dashboard",
    "db:seed": "node --experimental-transform-types --experimental-detect-module prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --experimental-transform-types --experimental-detect-module prisma/seed.ts"
  },
  "engines": {
    "node": ">=25.0.0",
    "pnpm": ">=10.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && git diff --cached --name-only | grep '\\.pem$' && echo 'ERROR: .pem file staged for commit' && exit 1 || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/node": "^25.4.0",
    "@vitest/browser": "^4.0.18",
    "better-sqlite3": "^12.6.2",
    "eslint": "^10.0.3",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.3",
    "prisma": "^7.5.0",
    "simple-git-hooks": "^2.13.1",
    "smol-toml": "^1.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  }
}
